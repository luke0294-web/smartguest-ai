{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "cd artifacts/api-server && pnpm dlx dotenv-cli -e ../../.env -- pnpm dev",
    "dev:web": "cd artifacts/rome-guest && PORT=5173 pnpm dlx dotenv-cli -e ../../.env -- pnpm dev",
    "dev": "concurrently -c \"cyan,magenta\" -n \"API,WEB\" \"pnpm run dev:api\" \"pnpm run dev:web\""
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "lightningcss-darwin-arm64": "^1.32.0",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
