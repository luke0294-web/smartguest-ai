{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "cd artifacts/api-server && pnpm dlx dotenv-cli -e ../../.env -- pnpm dev",
    "dev:web": "cd artifacts/rome-guest && PORT=5173 pnpm dlx dotenv-cli -e ../../.env -- pnpm dev",
    "dev": "concurrently -c \"cyan,magenta\" -n \"API,WEB\" \"pnpm run dev:api\" \"pnpm run dev:web\""
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.9",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js",
      "lightningcss",
      "rollup"
    ],
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "^3.23.8"
        }
      }
    },
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3",
      "brace-expansion@>=3.0.0 <5.0.12": ">=5.0.12 <6",
      "browserslist@<4.28.7": ">=4.28.7 <5",
      "dompurify@<3.4.16": ">=3.4.16 <4",
      "esbuild@<0.25.0": ">=0.25.0 <0.29.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29.0",
      "fast-copy@>=4.0.0 <4.1.0": ">=4.1.0 <5",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <5",
      "fast-uri@>=4.0.0 <4.1.5": ">=4.1.5 <5",
      "fflate@>=0.8.0 <0.8.3": ">=0.8.3 <0.9.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",
      "linkify-it@<=5.0.1": ">=5.0.2 <7",
      "markdown-it@<=14.1.1": ">=14.2.0 <16",
      "markdown-it@>=15.0.0 <15.0.1": ">=15.0.1 <16",
      "multer@<2.3.0": ">=2.3.0 <3",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "proxy-addr@>=1.1.0 <2.0.8": ">=2.0.8 <3",
      "qs@>=6.11.1 <6.16.0": ">=6.16.0 <7",
      "shell-quote@<1.11.0": ">=1.11.0 <2",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2 <2",
      "uuid@<11.1.1": ">=11.1.1 <15",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5 <9",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9"
    }
  }
}
