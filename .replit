modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

# 🟢 COMANDO RUN DEFINITIVO
# Questo accende tutto il workspace ignorando il pezzo rotto
run = "PORT=8080 BASE_PATH=/ pnpm -r --filter '!@workspace/mockup-sandbox' run dev"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["psmisc"]

[userenv]

[userenv.shared]
EMAIL_SMTP_HOST = "smtp.gmail.com"
EMAIL_SMTP_PORT = "465"
EMAIL_USER = "hello.smartguest@gmail.com"
EMAIL_PASS = "ajpt qsho ekqt lnqw"
EMAIL_FROM_NAME = "SmartGuest AI"
